# INDACO settings. Every script in scripts/indaco/ reads this file, then
# scripts/indaco/cluster.local.env if it exists: put your own values THERE (it is not in git,
# so pulling a new version of disensa never conflicts with them), e.g.
#   PARTITION="gpu"
#   SCRATCH_DIR="/scratch/wchung"
#   MAIL_USER="name.surname@unimi.it"
# Values marked CHECK are guesses until confirmed on INDACO (`sinfo -s`, the user guide,
# and the report of the check job that run_all.sh submits first).

# --- SLURM ---------------------------------------------------------------------------
PARTITION=""              # empty: the partition with GPUs, found with sinfo (lib.sh detect_slurm)
CPU_PARTITION=""          # for the final packing job (no GPU); empty = PARTITION
GRES="gpu:1"              # CHECK: one GPU. Some clusters want the type: gpu:a100:1
SCORE_GRES=""             # GPUs for the scorer (14B: a 40 GB+ GPU); empty = GRES
TIME=""                   # empty: the partition's own limit. A job near its limit puts
                          # itself back in the queue and continues (MAX_REQUEUE times)
CPUS=8
MEM="64G"                 # host memory: vLLM loads the weights through it
ACCOUNT=""                # only if jobs must name an account
QOS=""                    # only if the partition needs one
MAIL_USER=""              # an e-mail address: SLURM writes when everything is finished

# --- storage -------------------------------------------------------------------------
SCRATCH_DIR="${SCRATCH:-$HOME/scratch}"   # CHECK: large storage, ~120 GB for the weights

# --- software ------------------------------------------------------------------------
MODULES=""                # CHECK: modules to load on the GPU node, if any, e.g. "cuda/12.4"
VLLM_ENV="$HOME/envs/vllm"   # the vLLM environment (setup.sh creates it)
VLLM_VERSION=""           # empty = latest at setup time; setup.sh records what it installed

# --- vLLM ----------------------------------------------------------------------------
VLLM_DTYPE="auto"         # bfloat16 on A100/H100/L40. On a V100 (no bfloat16): "half"
VLLM_MAX_MODEL_LEN=4096   # a prompt is ~400-700 tokens, a reply at most 400. Without this
                          # limit vLLM reserves memory for 128k-token prompts and may not start
VLLM_GPU_MEM=0.90         # share of GPU memory vLLM may use
VLLM_EXTRA_ARGS=""        # e.g. "--tensor-parallel-size 2" with GRES=gpu:2
SCORE_VLLM_EXTRA_ARGS=""  # the same, for the scorer only
VLLM_WAIT_MIN=30          # minutes to wait for the server to load the weights

# --- the experiment ------------------------------------------------------------------
SCORER="microsoft/phi-4"  # rates every message after the runs (not an agent model family)
PARALLEL=4                # sweep shards side by side against one vLLM server
CORE_TASKS=3              # GPUs (array tasks) per 240-run sweep: ~80 runs, ~2 h each
MAX_SMOKE_FAILED=5        # % of failed replies above which the smoke run stops a job
MAX_REQUEUE=20            # times a job near its time limit puts itself back in the queue
REQUEUE_WARN=900          # seconds before the time limit at which a job requeues itself

_local="$(dirname "${BASH_SOURCE[0]}")/cluster.local.env"
# shellcheck source=/dev/null
if [[ -f "$_local" ]]; then source "$_local"; fi

# derived after the local settings, so changing SCRATCH_DIR there moves these too
HF_HOME="${HF_HOME_OVERRIDE:-$SCRATCH_DIR/hf}"         # model weights
CACHE_ROOT="${CACHE_ROOT_OVERRIDE:-$SCRATCH_DIR/disensa-cache}"   # reply caches, per shard
CPU_PARTITION="${CPU_PARTITION:-$PARTITION}"
SCORE_GRES="${SCORE_GRES:-$GRES}"
